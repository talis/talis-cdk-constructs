{
  "name": "talis-cdk-constructs",
  "version": "0.1.0",
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.js",
    "src/lambda/**",
    "src/npm-shrinkwrap.json",
    "src/package.json"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json -w",
    "typecheck": "tsc",
    "test": "vitest run",
    "unit-test": "vitest run test/unit",
    "infra-test": "vitest run test/infra",
    "integration-test": "vitest run test/integration",
    "lint": "oxfmt --check && oxlint && tsc",
    "format": "oxfmt",
    "prepare": "husky && npm run build",
    "release:dry-run": "semantic-release --dry-run --no-ci --branches \"$(git branch --show-current)\""
  },
  "devDependencies": {
    "@aws-sdk/client-api-gateway": "3.1163.0",
    "@aws-sdk/client-apigatewayv2": "3.1163.0",
    "@aws-sdk/client-cloudfront": "3.1163.0",
    "@aws-sdk/client-s3": "3.1163.0",
    "@aws-sdk/client-sqs": "3.1163.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "22.20.5",
    "aws-cdk": "2.1148.0",
    "aws-cdk-lib": "2.275.0",
    "axios": "1.21.0",
    "constructs": "10.8.1",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "semantic-release": "25.0.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.224.0",
    "constructs": "^10.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}

{
  "name": "talis-cdk-constructs",
  "version": "0.1.0",
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.js",
    "src/lambda/**",
    "src/npm-shrinkwrap.json",
    "src/package.json"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json -w",
    "typecheck": "tsc",
    "test": "vitest run",
    "unit-test": "vitest run test/unit",
    "infra-test": "vitest run test/infra",
    "integration-test": "vitest run test/integration",
    "lint": "oxfmt --check && oxlint && tsc",
    "format": "oxfmt",
    "prepare": "husky && npm run build"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/lodash": "4.17.27",
    "@types/node": "22.20.5",
    "aws-cdk": "2.1148.0",
    "aws-cdk-lib": "2.275.0",
    "aws-sdk": "2.1693.0",
    "axios": "1.21.0",
    "cdk-ecr-deployment": "4.2.84",
    "constructs": "10.8.1",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "semantic-release": "25.0.9",
    "talis-node": "github:talis/talis-node#v0.2.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.200.1",
    "constructs": "^10.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}

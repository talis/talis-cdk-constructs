{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":enableVulnerabilityAlerts",
    "security:minimumReleaseAgeNpm",
    ":maintainLockFilesWeekly",
    "schedule:weekends"
  ],
  "configMigration": true,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 1,
  "rangeStrategy": "auto",
  "autoApprove": true,
  "automergeType": "pr",
  "automerge": true,
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "production dependencies (minor/patch)",
      "groupSlug": "prod-minor-patch"
    },
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dev dependencies (minor/patch)",
      "groupSlug": "dev-minor-patch"
    },
    {
      "groupName": "oxc",
      "matchPackageNames": ["oxlint", "oxfmt"]
    },
    {
      "matchPackageNames": ["node", "cimg/node", "@types/node"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "groupName": "node dependencies",
      "groupSlug": "node-all"
    },
    {
      "description": "Types track the minimum supported Node.js runtime (Lambda nodejs22.x), not the dev version",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "22.x"
    },
    {
      "description": "conventionalcommits@10 needs conventional-changelog-writer@9, which no stable @semantic-release/release-notes-generator ships yet; lift once it does",
      "matchPackageNames": ["conventional-changelog-conventionalcommits"],
      "allowedVersions": "9.x"
    }
  ],
  "rebaseWhen": "behind-base-branch",
  "timezone": "Europe/London"
}

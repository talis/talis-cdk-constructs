{
  "compilerOptions": {
    // Node 22 is the oldest runtime we support (Lambda nodejs22.x, consumer synth)
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "types": ["node", "vitest/globals"],
    "strict": true,
    "strictPropertyInitialization": false,
    "noImplicitReturns": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["lib", "src/lambda", "src/types", "test", "examples", "*.ts"],
  "exclude": ["**/node_modules", "**/cdk.out"]
}
